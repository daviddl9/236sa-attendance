# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable

# Server
PORT=8080
ENVIRONMENT=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic API key for admin document-import flow (feature 002-agent-onboarding-flow).
# When unset, the document-import admin route is disabled; the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Polar Payments (optional)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Cloud Storage - Cloudflare R2 (optional)
R2_UPLOAD_IMAGE_ACCESS_KEY_ID=
R2_UPLOAD_IMAGE_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_UPLOAD_IMAGE_BUCKET_NAME=images

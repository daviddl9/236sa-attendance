# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?sslmode=disable

# Server
PORT={{ app_port }}
ENVIRONMENT={{ environment }}

# Frontend URL (for CORS)
FRONTEND_URL={{ frontend_url }}

# Google OAuth (optional)
{% if google_client_id is defined %}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
{% endif %}

# OpenAI (optional)
{% if openai_api_key is defined %}
OPENAI_API_KEY={{ openai_api_key }}
{% endif %}

# Polar Payments (optional)
{% if polar_access_token is defined %}
POLAR_ACCESS_TOKEN={{ polar_access_token }}
POLAR_WEBHOOK_SECRET={{ polar_webhook_secret }}
{% endif %}

# Cloud Storage - Cloudflare R2 (optional)
{% if r2_access_key_id is defined %}
R2_UPLOAD_IMAGE_ACCESS_KEY_ID={{ r2_access_key_id }}
R2_UPLOAD_IMAGE_SECRET_ACCESS_KEY={{ r2_secret_access_key }}
CLOUDFLARE_ACCOUNT_ID={{ cloudflare_account_id }}
R2_UPLOAD_IMAGE_BUCKET_NAME={{ r2_bucket_name | default('images') }}
{% endif %}
